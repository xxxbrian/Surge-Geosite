{
  "name": "@surge-geosite/panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run test:unit && pnpm run typecheck && pnpm run build",
    "test:unit": "svelte-kit sync && vitest run",
    "test:browser": "node --test test/browser/panel.test.mjs",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "playwright": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.44.0"
  }
}
